{
  "$schema": "node_modules/biome/configuration_schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "include": ["packages/*/src/**/*.{ts,tsx,js}", "packages/*/tests/**/*.{ts,tsx,js}", "packages/web/vite.config.ts"],
    "ignore": ["node_modules", "dist", "data", "site", "vendor"]
  }
}
