#!/usr/bin/env bash
# gh-run-watch — Watch CI run with smart initial delay
#
# Predicts CI duration from recent 50 runs (median), sleeps predictively,
# then delegates to `gh run watch` for real-time logs + exit code.
#
# Installation:
#   cp scripts/gh-run-watch ~/.local/share/gh/extensions/gh-run-watch/
#   chmod +x ~/.local/share/gh/extensions/gh-run-watch/gh-run-watch
#
# Usage:
#   gh run-watch [run-id] [-- <gh-run-watch-flags>]
#
# Examples:
#   gh run-watch                    # Watch latest run on current branch
#   gh run-watch --compact          # Show only relevant/failed steps
#   gh run-watch --exit-status      # Exit non-zero on failure (for CI scripts)
#   gh run-watch 12345678           # Watch specific run
#   git push && gh run-watch -q --compact --exit-status  # Full CI gate
#
# Flags (all passed through to gh run watch):
#   --compact        Show only relevant/failed steps
#   --exit-status    Exit with non-zero status if run fails
#   -q               Suppress progress and summary
#   -i, --interval   Refresh interval in seconds (default 3)
#   -R, --repo       Select repository
#
# Debug:
#   DEBUG_CI_WAIT=1 gh run-watch    # Print prediction timing
set -euo pipefail

predict_duration() {
  local workflow=${1:-".github/workflows/ci.yml"} branch=${2:-"main"}
  gh run list --workflow "$workflow" --branch "$branch" --limit 50 \
    --json conclusion,createdAt,updatedAt --jq \
    '.[] | select(.conclusion == "success") |
     ((.updatedAt | fromdateiso8601) - (.createdAt | fromdateiso8601))' \
    | sort -n | awk 'BEGIN{min=10} {a[NR]=$1}
      END{m=int((NR+1)/2); d=(NR%2)?a[m]:(a[m]+a[m+1])/2; print (d<min)?min:d}'
}

# --- resolve run_id ---
if [[ $# -gt 0 && "$1" != -* ]]; then
  run_id=$1
  shift
else
  branch=$(git branch --show-current 2>/dev/null || echo "main")
  run_id=$(gh run list --branch "$branch" --limit 1 \
    --json databaseId --jq '.[0].databaseId')
fi

if [[ -z "$run_id" || "$run_id" == "null" ]]; then
  echo "no recent run found" >&2
  exit 1
fi

# --- smart initial wait ---
predicted=$(predict_duration)
if [[ ${DEBUG_CI_WAIT:-0} -eq 1 ]]; then
  echo "DEBUG: predicted=${predicted}s, initial_wait=$((predicted + 15))s" >&2
fi

predict_start=$(date +%s)
sleep $((predicted + 15))

# --- delegate to gh run watch ---
exec gh run watch "$run_id" "$@"
