# Workouts CLI — 应用级环境变量
# 复制为 .env 或 export 后运行 docker compose / bundle exec

# ── 数据源凭据 ──────────────────────────────────

# Keep
# SYNC__KEEP__PHONE=
# SYNC__KEEP__PASSWORD=

# iGPSPORT
# SYNC__IGPSPORT__PHONE=
# SYNC__IGPSPORT__PASSWORD=

# XOSS (International)
# SYNC__XOSS__EMAIL=
# SYNC__XOSS__PASSWORD=

# XingZhe / 行者 (China)
# SYNC__XINGZHE__EMAIL=
# SYNC__XINGZHE__PASSWORD=

# Strava (OAuth2)
# SYNC__STRAVA__CLIENT_ID=
# SYNC__STRAVA__CLIENT_SECRET=
# SYNC__STRAVA__REFRESH_TOKEN=

# Garmin International (garmin.com)
# SYNC__GARMIN__EMAIL=
# SYNC__GARMIN__PASSWORD=
# SYNC__GARMIN__AUTH_SEED=

# Garmin China (garmin.cn)
# SYNC__GARMIN_CN__EMAIL=
# SYNC__GARMIN_CN__PASSWORD=
# SYNC__GARMIN_CN__SECRET=

# ── Sync 全局（可选） ────────────────────────────

# SYNC__TIME_BUDGET=           # 单次同步最大秒数
# SYNC__TOTAL_TIMEOUT=         # Runner 总超时秒数

# ── Migrate（可选） ──────────────────────────────

# MIGRATE__IGPSPORT_TO_GARMIN__LIMIT=10
# MIGRATE__IGPSPORT_TO_GARMIN_CN__LIMIT=10
