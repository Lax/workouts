# Workouts CLI — 应用级环境变量
# 复制为 .env 或 export 后运行 bundle exec
# 前缀 GIT_FIT_ 与 git-fit gem 一致（git fit init 模板）

# ── 数据源凭据 ──────────────────────────────────

# Keep
# GIT_FIT_KEEP_PHONE=
# GIT_FIT_KEEP_PASSWORD=

# iGPSPORT
# GIT_FIT_IGPSPORT_PHONE=
# GIT_FIT_IGPSPORT_PASSWORD=

# XOSS (International)
# GIT_FIT_XOSS_EMAIL=
# GIT_FIT_XOSS_PASSWORD=
# GIT_FIT_XOSS_TOKEN_PATH=          # 默认 data/auth/xoss/tokens.json

# XingZhe / 行者 (China)
# GIT_FIT_XINGZHE_EMAIL=
# GIT_FIT_XINGZHE_PASSWORD=
# GIT_FIT_XINGZHE_SESSION_PATH=     # 默认 data/auth/xingzhe/session.json

# Strava (OAuth2)
# GIT_FIT_STRAVA_CLIENT_ID=
# GIT_FIT_STRAVA_CLIENT_SECRET=
# GIT_FIT_STRAVA_REFRESH_TOKEN=
# GIT_FIT_STRAVA_WEB_AUTH_JWT=           # strava_remember_token（git fit strava fetch）
# GIT_FIT_STRAVA_WEB_AUTH_AUTH_SEED=     # base64 JWT

# Garmin International (garmin.com)
# GIT_FIT_GARMIN_EMAIL=
# GIT_FIT_GARMIN_PASSWORD=
# GIT_FIT_GARMIN_AUTH_SEED=          # DI OAuth2 token（git fit auth garmin 自动写入）

# Garmin China (garmin.cn)
# GIT_FIT_GARMIN_CN_EMAIL=
# GIT_FIT_GARMIN_CN_PASSWORD=
# GIT_FIT_GARMIN_CN_SECRET=          # OAuth1+OAuth2 token（git fit auth garmin_cn 自动写入）
# GIT_FIT_GARMIN_CN_TOKEN_PATH=      # token 文件路径

# Lorem（测试适配器，仅本地开发）
# GIT_FIT_LOREM_COUNT=

# ── Sync 全局（可选） ────────────────────────────

# GIT_FIT_SYNC_WORKERS=          # 并行 worker 数（默认 3）
# GIT_FIT_SYNC_TIME_BUDGET=      # 单次同步最大秒数
# GIT_FIT_SYNC_TOTAL_TIMEOUT=    # Runner 总超时秒数
# GIT_FIT_DATABASE_PATH=         # SQLite 路径（默认 data/db/workouts.db）
# GIT_FIT_SYSTEM_TIMEZONE=       # 时区（默认 Asia/Shanghai）
