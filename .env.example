# Workouts CLI - Environment Variables
# Set these in .env or export them before running docker-compose

# Strava (OAuth2)
# SYNC__STRAVA__CLIENT_ID=
# SYNC__STRAVA__CLIENT_SECRET=
# SYNC__STRAVA__REFRESH_TOKEN=

# Garmin Connect
# SYNC__GARMIN__EMAIL=
# SYNC__GARMIN__PASSWORD=

# Keep
# SYNC__KEEP__PHONE=
# SYNC__KEEP__PASSWORD=

# iGPSPORT
# SYNC__IGPSPORT__PHONE=
# SYNC__IGPSPORT__PASSWORD=

# XOSS (International)
# SYNC__XOSS__EMAIL=
# SYNC__XOSS__PASSWORD=

# XingZhe / 行者 (China)
# SYNC__XINGZHE__EMAIL=
# SYNC__XINGZHE__PASSWORD=
