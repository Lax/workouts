# Map tile vendor: carto (default, free) | mapbox | openfreemap | maptiler | stadiamaps
VITE__MAP_TILE_VENDOR=carto
# Vendor-specific style name (see tiles.ts for options)
VITE__MAP_TILE_STYLE=dark-nolabels
# Token only needed for mapbox/maptiler/stadiamaps
VITE__MAP_TILE_TOKEN=

# Mapbox token (legacy, falls back to VITE__MAP_TILE_TOKEN)
# Get yours at https://account.mapbox.com/access-tokens/
VITE__MAPBOX__TOKEN=pk.your_mapbox_token_here

# GitHub username for header avatar (shown when site.logo is null)
VITE_GITHUB_USER=Lax
