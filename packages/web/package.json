{
  "name": "@workouts/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-entries.mjs && node scripts/generate-real-fixtures.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-entries.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate-fixtures": "node scripts/generate-fixtures.mjs",
    "verify-build-output": "node scripts/verify-build-output.mjs"
  },
  "dependencies": {
    "@workouts/shared": "*",
    "@workouts/core": "*",
    "@workouts/plugin-data-source": "*",
    "@workouts/plugin-map": "*",
    "@workouts/plugin-chart": "*",
    "@workouts/plugin-ui": "*",
    "@workouts/theme-hello-world": "*",
    "@workouts/theme-simple": "*",
    "@workouts/theme-overview": "*",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
