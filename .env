# Workouts CLI — 配置选项（非敏感，入库版本化）
# 镜像 GitHub Variables（sync.yml / gh-pages.yml 经 vars.* 注入同一组值）
# 本地凭据放 .env.local（已 gitignore，模板见 .env.local.example）
# 本地覆盖任意配置：在 .env.local 里重复该 key 即可（后加载覆盖）
# 加载顺序：set -a; source .env; source .env.local; set +a

# ── Sync 全局 ──
GIT_FIT_SYNC_WORKERS=3
GIT_FIT_SYNC_TIME_BUDGET=30
GIT_FIT_SYNC_TOTAL_TIMEOUT=1500
GIT_FIT_DATABASE_PATH=data/db/workouts.db
GIT_FIT_SYSTEM_TIMEZONE=Asia/Shanghai
GIT_FIT_CONFIG_PATH=config.yml

# ── 本地开发 ──
GIT_FIT_LOREM_COUNT=0

# ── Auth 存储路径（非敏感） ──
GIT_FIT_XOSS_TOKEN_PATH=data/auth/xoss/tokens.json
GIT_FIT_XINGZHE_SESSION_PATH=data/auth/xingzhe/session.json
GIT_FIT_GARMIN_CN_TOKEN_PATH=data/auth/garmin_cn/tokens.json

# ── AI insights（endpoint/model 非敏感；key 放 .env.local 的 AI_API_KEY） ──
# 默认 opencode zen（key 已有，实测对比见 #43）：mimo-v2.5-free 快且契约合规
GIT_FIT_AI_ENABLED=false
GIT_FIT_AI_ENDPOINT=https://opencode.ai/zen/v1
GIT_FIT_AI_MODEL=mimo-v2.5-free

# ── 策略 B（Playwright）可选覆盖，不设则用系统默认 ──
# GIT_FIT_GARMIN_CHROMIUM_PATH=
# GIT_FIT_PLAYWRIGHT_CLI_PATH=
