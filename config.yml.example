---
# 参考模板。权威模板由 `git fit init` 生成（git-fit gem ConfigTemplate）。
# env 前缀用 GIT_FIT_（与 git-fit 一致）。

database:
  path: data/db/workouts.db

sync:
  # workers: 3                                 # env: GIT_FIT_SYNC_WORKERS
  # time_budget: 90                            # env: GIT_FIT_SYNC_TIME_BUDGET (seconds)
  # total_timeout: 600                         # env: GIT_FIT_SYNC_TOTAL_TIMEOUT (seconds)

  # strava:                                    # env: GIT_FIT_STRAVA_CLIENT_ID
  #   client_id: ""                            # env: GIT_FIT_STRAVA_CLIENT_SECRET
  #   refresh_token: ""                        # env: GIT_FIT_STRAVA_REFRESH_TOKEN
  #   web_auth:                                # web original-file fetch (git fit strava fetch)
  #     jwt: ""                                # env: GIT_FIT_STRAVA_WEB_AUTH_JWT (strava_remember_token)
  #     auth_seed: ""                          # env: GIT_FIT_STRAVA_WEB_AUTH_AUTH_SEED (base64 JWT)
  #     cookie_path: ""                        # default data/auth/strava/session.yml

  # garmin:                                    # env: GIT_FIT_GARMIN_EMAIL
  #   email: ""                                # env: GIT_FIT_GARMIN_PASSWORD
  #   password: ""
  #   auth_seed: ""                            # auto-written by git fit auth garmin
  #   secret: ""                               # CN SSO secret (auto-written by git fit auth garmin_cn)

  # garmin_cn:                                 # env: GIT_FIT_GARMIN_CN_EMAIL
  #   email: ""                                # env: GIT_FIT_GARMIN_CN_PASSWORD
  #   password: ""

  # keep:                                      # env: GIT_FIT_KEEP_PHONE
  #   phone: ""                                # env: GIT_FIT_KEEP_PASSWORD
  #   password: ""

  # igpsport:                                  # env: GIT_FIT_IGPSPORT_PHONE
  #   phone: ""                                # env: GIT_FIT_IGPSPORT_PASSWORD
  #   password: ""

  # lorem:                                     # env: GIT_FIT_LOREM_COUNT
  #   count: 5

  # xoss:                                        # env: GIT_FIT_XOSS_EMAIL
  #   email: ""                                  # env: GIT_FIT_XOSS_PASSWORD
  #   password: ""
  #   token_path: ""                             # env: GIT_FIT_XOSS_TOKEN_PATH
  #                                              # default data/auth/xoss/tokens.json

  # xingzhe:                                     # env: GIT_FIT_XINGZHE_EMAIL
  #   email: ""                                  # env: GIT_FIT_XINGZHE_PASSWORD
  #   password: ""
  #   session_path: ""                           # env: GIT_FIT_XINGZHE_SESSION_PATH
  #                                              # default data/auth/xingzhe/session.json

export:
  json:
    path: site/activities.json

  # csv:
  #   path: site/workouts.csv

  # gpx:
  #   path: site/gpx_out

privacy:
  start_end_range: 200

system:
  units: metric
  log_level: info
  timezone: Asia/Shanghai
