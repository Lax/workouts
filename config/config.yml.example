---
# 参考模板。权威模板由 `git fit init` 生成（git-fit gem ConfigTemplate）。
# env 前缀用 GIT_FIT_（与 git-fit 一致）。

database:
  path: data/db/workouts.db

sync:
  # workers: 3                                 # env: GIT_FIT_SYNC_WORKERS
  # time_budget: 90                            # env: GIT_FIT_SYNC_TIME_BUDGET (seconds)
  # total_timeout: 600                         # env: GIT_FIT_SYNC_TOTAL_TIMEOUT (seconds)

  # amap:                       # 高德 Web 服务 API (行政区逆地理编码)
  #   api_key: "your_key"       # env: AMAP_API_KEY

  # strava:                                    # env: GIT_FIT_STRAVA_CLIENT_ID
  #   client_id: ""                            # env: GIT_FIT_STRAVA_CLIENT_SECRET
  #   refresh_token: ""                        # env: GIT_FIT_STRAVA_REFRESH_TOKEN

  # garmin:                                    # env: GIT_FIT_GARMIN_EMAIL
  #   email: "your@email.com"                  # env: GIT_FIT_GARMIN_PASSWORD
  #   password: "your_password"
  #   auth_seed: "base64..."                   # DI OAuth2 token (env: GIT_FIT_GARMIN_AUTH_SEED)

  # garmin_cn:                                 # env: GIT_FIT_GARMIN_CN_EMAIL
  #   email: "13800138000"                     # env: GIT_FIT_GARMIN_CN_PASSWORD
  #   password: "your_password"
  #   secret: "base64..."                      # OAuth1+OAuth2 token (env: GIT_FIT_GARMIN_CN_SECRET)

  # keep:                                      # env: GIT_FIT_KEEP_PHONE
  #   phone: "13800138000"                     # env: GIT_FIT_KEEP_PASSWORD
  #   password: "your_password"

  # igpsport:                                  # env: GIT_FIT_IGPSPORT_PHONE
  #   phone: "13800138000"                     # env: GIT_FIT_IGPSPORT_PASSWORD
  #   password: "your_password"

  # xoss:                                      # env: GIT_FIT_XOSS_EMAIL
  #   email: "your@email.com"                  # env: GIT_FIT_XOSS_PASSWORD
  #   password: "your_password"

  # xingzhe:                                   # env: GIT_FIT_XINGZHE_EMAIL
  #   email: "13800138000"                     # env: GIT_FIT_XINGZHE_PASSWORD
  #   password: "your_password"
  #   session_path: "data/cache/xingzhe_session.json"  # env: GIT_FIT_XINGZHE_SESSION_PATH

export:
  json:
    path: site/activities.json
  csv:
    path: site/workouts.csv

privacy:
  start_end_range: 200

system:
  units: metric
  log_level: info
  timezone: Asia/Shanghai
